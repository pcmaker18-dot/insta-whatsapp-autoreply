{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InstaAutoReply",
  "version": "0.4.0",
  "identifier": "com.pcmaker.instaautoreply",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "InstaAutoReply — الرد التلقائي",
        "width": 1180,
        "height": 780,
        "minWidth": 940,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
