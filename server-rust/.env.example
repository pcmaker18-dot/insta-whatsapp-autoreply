# رمز الوصول لحساب Instagram الاحترافي (Instagram API with Instagram Login)
IG_ACCESS_TOKEN=IGAA...
# كلمة تختارها أنت وتضعها نفسها في إعدادات Webhook على Meta
VERIFY_TOKEN=my_secret_verify_word
# App Secret من لوحة تطبيق Meta
APP_SECRET=xxxxxxxxxxxxxxxx
# رقم واتساب بالصيغة الدولية بدون + (مثال للجزائر)
WHATSAPP_NUMBER=213555123456
# اختياري: نص رسالة مخصص بدل الافتراضي
# REPLY_TEXT=مرحباً، تواصل معنا على واتساب: https://wa.me/213555123456
# اختياري: لا يُعاد الرد على نفس الشخص قبل مرور هذه المدة (بالساعات)
COOLDOWN_HOURS=24
PORT=8080
